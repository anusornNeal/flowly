{
  "name": "flowly",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "flowly": "./bin/flowly.cjs"
  },
  "type": "module",
  "description": "Local-first agent-operated project board and visual QA workspace",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/main.ts",
    "cli": "tsx packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts tests/skills/*.test.ts",
    "test:skills": "tsx --test --test-concurrency=1 tests/skills/*.test.ts",
    "verify:skill-engine": "tsx scripts/verify-skill-engine.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "lucide-react": "^0.546.0",
    "playwright": "^1.62.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
